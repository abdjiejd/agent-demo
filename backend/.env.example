# 项目名称
PROJECT_NAME=Chat Demo

# 服务端口
SERVER_PORT=8082
FRONTEND_PORT=8081

# 上下文记忆轮数
CONTEXT_ROUNDS=5

# 工具调用最大轮数
TOOL_CALL_MAX_ROUNDS=5

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=agent_demo

# 火山引擎 Ark API 配置
ARK_API_KEY=your-ark-api-key
ARK_MODEL=your-model-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
